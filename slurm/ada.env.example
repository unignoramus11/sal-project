# Copy to slurm/ada.env and fill in once (values from `sacctmgr show assoc user=$USER` and `sinfo`).
ACCOUNT=            # e.g. research    (sbatch -A)
PARTITION=          # e.g. long        (sbatch -p); leave empty for the default
GPU_GRES=gpu:1      # e.g. gpu:1, or gpu:2080ti:1 to prefer 2080 Ti nodes
CPUS=10
MEM=60G
# A directory with ~150 GB free that survives between jobs (not node-local scratch)
WORK=/share1/$USER/sal-project
